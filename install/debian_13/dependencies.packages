# Base tools the other install scripts rely on
curl
wget
gnupg2

# Reads and writes the Wayland clipboard, for u-copy and u-paste
wl-clipboard

# Renders the QR code printed by the lanip function
qrencode

# GitHub CLI, used for auth and gists
gh

# The picker behind gistpad
fzf

# Encrypts what u-copy sends, to the SSH keys on the GitHub account
age

# Reads GNOME settings as typed values, for the nikit commands
python3-gi
