# Base tools the other install scripts rely on
curl
wget
gnupg2

# Reads and writes the Wayland clipboard, for u-share
wl-clipboard

# Renders the QR code printed by the lanip function
qrencode

# Builds the JSON body gistpad sends to the gists API
jq

# GitHub CLI, used for auth and gists
gh

# The picker behind gistpad
fzf

# Encrypts what u-share carries, to the SSH keys on the GitHub account
age
